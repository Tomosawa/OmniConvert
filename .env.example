# OmniConvert 环境变量示例
# 复制本文件为 .env 后按需填写。本项目纯前端,无后端密钥;
# 此处主要用于构建期开关和未来扩展。

# 应用元信息
NUXT_PUBLIC_APP_NAME=OmniConvert
NUXT_PUBLIC_APP_VERSION=0.0.1

# 文件大小阈值(超过则提示使用桌面版),单位字节,默认 500MB
NUXT_PUBLIC_LARGE_FILE_THRESHOLD=524288000

# 是否启用历史记录(IndexedDB)
NUXT_PUBLIC_ENABLE_HISTORY=true

# 默认并发任务数
NUXT_PUBLIC_DEFAULT_CONCURRENCY=2
